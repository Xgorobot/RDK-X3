<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xgo_head</name>
  <version>0.0.0</version>
  <description>Head UI and ROS integration for XGO</description>
  <maintainer email="chengyangkj@todo.todo">chengyangkj</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build dependencies -->
  <build_depend>rclcpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>ai_msgs</build_depend>
  <build_depend>hbm_img_msgs</build_depend>
  <build_depend>audio_msg</build_depend>
  <build_depend>xgolib</build_depend>
  <build_depend>xgoscreen</build_depend>

  <!-- Exec dependencies -->
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ai_msgs</exec_depend>
  <exec_depend>hbm_img_msgs</exec_depend>
  <exec_depend>audio_msg</exec_depend>
  <exec_depend>xgolib</exec_depend>
  <exec_depend>xgoscreen</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
